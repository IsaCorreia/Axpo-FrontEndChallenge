@rendermode InteractiveServer

<div class='details'>
    <div class='details-header'>
        <p>Overview</p> <img src="media\icons\chevron_up.svg" />
    </div>
    <div class='details-cols'>
        <div class='details-col'>
            <div class='details-info'>
                <p class='details-info-title'>Contract Type</p>
                <p class='details-info-data'>Existing Client - New Business</p>
            </div>
            <div class='details-info'>
                <p class='details-info-title'>Country</p>
                <div class='details-info-data'><img src="media\icons\FR.svg" /><p>France</p></div>
            </div>
            <div class='details-info'>
                <p class='details-info-title'>Period</p>
                <p class='details-info-data'>01/01/2023 - 31/12/2027</p>
            </div>
        </div>
        <div class='details-col'>
            <div class='details-info'>
                <p class='details-info-title'>Commodity</p>
                <p class='details-info-data'>Power</p>
            </div>
            <div class='details-info'>
                <p class='details-info-title'>Signature Date</p>
                <p class='details-info-data'>24/04/2027</p>
            </div>
        </div>
    </div>
