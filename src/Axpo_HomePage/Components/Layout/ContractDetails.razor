@using System.Reflection.Metadata
@using Microsoft.VisualBasic
@rendermode InteractiveServer

<div class='details'>
    <div class='details-header'>
        <p>Overview</p>
        <img class="@(ShouldCollapse ? "point-down" : "point-up")" @onclick="() => toggleCollapse()"
            src="media\icons\chevron_up.svg" />
    </div>
    @if (!ShouldCollapse)
    {
        <div class="details-cols">

            <div class='details-col'>
                <div class='details-info'>
                    <p class='details-info-title' title="Contract Type">Contract Type</p>
                    <p class='details-info-data' title="Existing Client - New Business">Existing Client - New Business</p>
                </div>
                <div class='details-info'>
                    <p class='details-info-title' title="Country">Country</p>
                    <p class='details-info-data' title="France"><img src="media\icons\FR.svg" />France</p>
                </div>
                <div class='details-info'>
                    <p class='details-info-title' title="Period">Period</p>
                    <p class='details-info-data' title="01/01/2023 - 31/12/2027">01/01/2023 - 31/12/2027</p>
                </div>
            </div>
            <div class='details-col'>
                <div class='details-info'>
                    <p class='details-info-title' title="Commodity">Commodity</p>
                    <p class='details-info-data' title="Power">Power</p>
                </div>
                <div class='details-info'>
                    <p class='details-info-title' title="Signature Date">Signature Date</p>
                    <p class='details-info-data' title="24/04/2027">24/04/2027</p>
                </div>
            </div>
        </div>
    }
</div>

@code {
    bool ShouldCollapse = false;
    public void toggleCollapse() => ShouldCollapse = !ShouldCollapse;
}
